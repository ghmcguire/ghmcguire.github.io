---

<section id="experience" class="relative py-24 max-w-6xl mx-auto px-6 border-t border-white/5">
  <div class="space-y-4 mb-16">
    <span class="font-sans text-xs uppercase tracking-widest text-[#d4ded7]/50 block">Background</span>
    <h2 class="font-display text-4xl sm:text-5xl text-[#ede8e1] tracking-tight font-normal">
      Experience &amp; Leadership
    </h2>
  </div>

  <div class="space-y-12">
    {timeline.map((item, index) => (
      <div class="editorial-panel p-8 rounded-sm border border-white/10 group">
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 pb-3 border-b border-white/5">
          <div>
            <span class="font-sans text-xs uppercase tracking-wider text-[#618c77] font-semibold block mb-1">
              {item.company}
            </span>
            <h3 class="font-display text-2xl text-[#ede8e1] font-normal">
              {item.role}
            </h3>
          </div>
          <span class="font-editorial text-base text-[#d4ded7]/60">
            {item.period}
          </span>
        </div>

        <p class="font-editorial text-base text-[#d4ded7]/80 leading-relaxed mt-4 max-w-3xl">
          {item.description}
        </p>

        <div class="flex flex-wrap gap-2 pt-4">
          {item.tags.map((tag) => (
            <span class="px-2 py-0.5 rounded border border-white/10 font-sans text-[10px] tracking-wide text-[#d4ded7]/60">
              {tag}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
