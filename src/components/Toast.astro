<!-- Global Toast Notification Container -->
<div 
  id="global-toast" 
  class="fixed bottom-8 left-1/2 -translate-x-1/2 z-50 flex items-center gap-2.5 px-4 py-2.5 rounded-full bg-[#181d1a]/95 border border-[#618c77]/40 shadow-2xl backdrop-blur-md opacity-0 pointer-events-none transform translate-y-3 transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"
  role="status"
  aria-live="polite"
>
  <div class="w-4 h-4 rounded-full bg-[#618c77]/20 flex items-center justify-center text-[#618c77]">
    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="20 6 9 17 4 12"></polyline>
    </svg>
  </div>
  <span id="toast-message" class="font-editorial text-sm text-[#ede8e1] tracking-wide font-normal">
    Copied hello@gabemcg.dev to clipboard!
  </span>
</div>

<script>
  const toast = document.getElementById('global-toast');
  const toastMsg = document.getElementById('toast-message');
  let timeoutId: number;

  export function showToast(message = 'Copied hello@gabemcg.dev to clipboard!') {
    if (!toast) return;
    if (toastMsg) toastMsg.textContent = message;

    toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-3');
    toast.classList.add('opacity-100', 'translate-y-0');

    clearTimeout(timeoutId);
    timeoutId = window.setTimeout(() => {
      toast.classList.remove('opacity-100', 'translate-y-0');
      toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-3');
    }, 2200);
  }

  // Listen for custom trigger
  window.addEventListener('show-toast', ((e: CustomEvent) => {
    showToast(e.detail?.message);
  }) as EventListener);

  // Global listener for elements with data-copy-email
  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('[data-copy-email]');
    if (target) {
      e.preventDefault();
      const email = target.getAttribute('data-copy-email') || 'hello@gabemcg.dev';
      navigator.clipboard.writeText(email).then(() => {
        showToast(`Copied ${email} to clipboard!`);
      }).catch(() => {
        // Fallback
        showToast(`Copied ${email} to clipboard!`);
      });
    }
  });
</script>
