---
const currentYear = new Date().getFullYear();
const yearsExperience = currentYear - 2013;

const metrics = [
  {
    value: "400,000+",
    label: "Users Supported",
    context: "Designed mobile enterprise training across the US & Canada",
    highlight: true,
  },
  {
    value: "70+",
    label: "Designers Mentored",
    context: "Led design critique across 20+ iOS apps at Georgia Tech",
    highlight: false,
  },
  {
    value: "4 Platforms",
    label: "Design Engineering",
    context: "Production UI in SwiftUI, Compose, React & Tailwind",
    highlight: false,
  },
  {
    value: `${yearsExperience}+ Yrs`,
    label: "Coding & Building",
    context: "Self-taught software engineering since January 2013",
    highlight: false,
  },
];
---

<section class="relative py-12 max-w-6xl mx-auto px-6 border-t border-white/5">
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
    {metrics.map((metric) => (
      <div class="editorial-panel p-6 rounded-sm border border-white/10 group hover:border-[#618c77]/40 transition-colors space-y-2">
        <div class="font-display text-3xl sm:text-4xl lg:text-5xl text-[#ede8e1] tracking-tight font-normal group-hover:text-white transition-colors">
          {metric.value}
        </div>
        <div>
          <span class="font-sans text-xs uppercase tracking-wider text-[#618c77] font-semibold block">
            {metric.label}
          </span>
          <p class="font-editorial text-sm text-[#d4ded7]/70 leading-snug mt-1">
            {metric.context}
          </p>
        </div>
      </div>
    ))}
  </div>
</section>
